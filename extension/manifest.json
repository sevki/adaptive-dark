{
  "manifest_version": 3,
  "name": "Adaptive Dark Mode",
  "version": "0.1.0",
  "description": "Darkens light websites that don't support dark mode, preserving hue and contrast. A port of Safari's Adaptive Dark Mode.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/color.js", "lib/engine.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Adaptive Dark Mode",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" }
}
